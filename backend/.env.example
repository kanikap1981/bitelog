APP_ENV=development
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-6.1-sol
DATABASE_URL=postgresql://bitelog:bitelog@localhost:5432/bitelog
REDIS_URL=redis://localhost:6379/0
# Comma-separated invite_id:sha256_digest entries. Never store plaintext codes here.
INVITE_CODE_HASHES=
# Generate a private random value of at least 32 bytes for signed five-day access tokens.
INVITE_TOKEN_SECRET=
INVITE_TOKEN_TTL_SECONDS=432000
# Keep false until every supported client redeems and sends invite access tokens.
INVITE_ENFORCEMENT_ENABLED=false
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=bitelog-meals
S3_ACCESS_KEY_ID=bitelog
S3_SECRET_ACCESS_KEY=bitelogsecret
MAX_INLINE_IMAGE_BYTES=6000000
